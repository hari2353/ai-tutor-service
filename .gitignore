__pycache__/
*.pyc
.venv/
.pytest_cache/
node_modules/
target/

# operational data from the job-hunter agent, not curriculum: a live queue of
# real listings being targeted. Stays on disk, stays out of history.
interview_prep_queue.json

# OneDrive / Windows shell droppings
desktop.ini
Thumbs.db
.DS_Store

# Instagram crawl output: mining/crawl_state/ holds LIVE session cookies and
# mining/posts/ holds downloaded media. Never commit either.
mining/crawl_state/
mining/posts/

# crawl-derived bulk artifacts: the 80MB+ social graph and similar dumps are
# operational data, not curriculum. Regenerate with scripts/ig_crawler.
mining/graph.json

# local AI-tool configs carry live API keys (Bearer tokens). Keep them out of
# history; they are machine-local, never part of the curriculum.
opencode.json
.claude/settings.local.json

# app/data/*.js and *.json ARE tracked on purpose: the app loads them from
# file:// with no build step, so a fresh clone must open by double-click
# without anyone running Python first.
